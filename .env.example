# Copy this file to .env.local. These browser-safe values identify the
# Supabase project; they must never contain a database password, secret key,
# service-role key, payment key, or other privileged credential.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_browser_key

# UI opt-in only. No Razorpay secret belongs in a VITE_* variable.
# Server test credentials + manual capture + webhook must also be configured.
VITE_ENABLE_RAZORPAY_TEST=false

# The measured AR proof is operator-controlled and disabled by default.
VITE_ENABLE_DEVELOPMENT_AR_PROOF=true
