# Copy this file to .env.local and adjust only if you need to point at a REAL
# Firebase project. The defaults below (also baked into src/config/env.ts)
# target a "demo-" project ID, which the Firebase Local Emulator Suite treats
# as a fully offline, zero-cost, no-real-project-needed sandbox. Local dev
# and CI work with none of these variables set at all.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-artvault
VITE_FIREBASE_STORAGE_BUCKET=demo-artvault.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# When true, the app connects the Firebase client SDKs to the local
# Emulator Suite instead of a real backend. Keep this true until a real
# Firebase project is deliberately provisioned (see docs/DEPLOYMENT.md).
VITE_USE_FIREBASE_EMULATORS=true
