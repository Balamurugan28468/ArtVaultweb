rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Fields a customer may change via Edit Profile (Module 03). photoURL is
    // deliberately excluded: no avatar-upload feature exists yet, so the
    // rule grants no capability the app doesn't actually use — see
    // ARTVAULT_PROJECT_STATE.md, "Avatar Foundation".
    function editableProfileKeys() {
      return ['displayName', 'phoneNumber', 'bio', 'profileCompleted', 'updatedAt'];
    }

    function isValidDisplayName(value) {
      return value is string && value.size() >= 2 && value.size() <= 60;
    }

    function isValidOptionalString(value, maxSize) {
      return value == null || (value is string && value.size() <= maxSize);
    }

    // A client-issued update to users/{uid} may only ever change the fields
    // in editableProfileKeys() — enforced via the diff's affected-keys set,
    // not just a blanket "same uid" check — so no request can inject a new,
    // unlisted field (privileged or otherwise) or overwrite an identity
    // field, whether via updateDoc() or a full setDoc() overwrite (Firestore
    // rules treat both the same way once the document already exists).
    function isValidProfileUpdate() {
      let incoming = request.resource.data;
      let existing = resource.data;
      let changedKeys = incoming.diff(existing).affectedKeys();

      return
        incoming.uid == existing.uid &&
        incoming.email == existing.email &&
        incoming.role == existing.role &&
        incoming.createdAt == existing.createdAt &&
        incoming.photoURL == existing.photoURL &&
        changedKeys.hasOnly(editableProfileKeys()) &&
        isValidDisplayName(incoming.displayName) &&
        isValidOptionalString(incoming.phoneNumber, 20) &&
        isValidOptionalString(incoming.bio, 280) &&
        incoming.profileCompleted is bool &&
        incoming.updatedAt == request.time;
    }

    // The only role a client can ever claim while creating its own profile:
    // exactly the role already on its own authenticated ID token (custom
    // claims are set exclusively by trusted Admin SDK code — onUserCreate,
    // setAdminClaim.ts, promoteSeller.ts — and are cryptographically signed
    // into the token, so a client can never forge or choose this value),
    // or 'CUSTOMER' if no role claim exists yet. A CUSTOMER's token can
    // only ever produce 'CUSTOMER' here; a SELLER's can only ever produce
    // 'SELLER' — this is what makes client-triggered self-provisioning
    // (see ensureUserProfile.ts) safe against privilege escalation.
    function trustedCreateRole() {
      return 'role' in request.auth.token ? request.auth.token.role : 'CUSTOMER';
    }

    // A client may create ONLY its own users/{uid} document (uid == path id
    // == request.auth.uid, enforced by isOwner() below), and only in the
    // canonical shape onUserCreate itself would have produced — every field
    // the client might otherwise choose freely is independently re-derived
    // here from the authenticated identity/token, never trusted from the
    // request body. This exists so a client can safely self-heal a missing
    // profile (see ensureUserProfile.ts) without onUserCreate being a
    // single point of failure for a core account guarantee. Firestore's own
    // create-vs-update semantics — a write is evaluated as `create` only
    // when no document currently exists at this path, `update` otherwise —
    // mean this rule branch can never be used to overwrite an existing
    // profile; that path always goes through isValidProfileUpdate() above
    // instead, however the write was made.
    function isValidUserCreate(data) {
      return
        data.uid == request.auth.uid &&
        data.email == request.auth.token.email &&
        data.role == trustedCreateRole() &&
        data.role in ['CUSTOMER', 'SELLER', 'ADMIN', 'SUPER_ADMIN'] &&
        isValidOptionalString(data.displayName, 60) &&
        data.photoURL == null &&
        isValidOptionalString(data.phoneNumber, 20) &&
        isValidOptionalString(data.bio, 280) &&
        data.profileCompleted == false &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    // Created by the onUserCreate Cloud Function (Admin SDK, defense in
    // depth) or by the owning client itself via the tightly-constrained
    // create rule below (see ensureUserProfile.ts) — either way, exactly
    // one canonical document, never a client-chosen shape. A user may read
    // and update their own profile, but only through isValidProfileUpdate()
    // above; role/uid/email/createdAt/photoURL changes are structurally
    // impossible from the client, not just discouraged.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUserCreate(request.resource.data);
      allow update: if isOwner(uid) && isValidProfileUpdate();
      allow delete: if false;
    }

    // Reads the SELLER custom claim directly from the auth token — never
    // trusts the users/{uid}.role mirror field, matching the existing
    // Module 01 rule that role is only ever authoritative as a token claim.
    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    // Module 13 Phase 3 — the Admin Control Center's review queues need an
    // ADMIN/SUPER_ADMIN to list documents that are not their own, which no
    // rule in this file granted before this module (every prior privileged
    // write went through the Admin SDK, which always bypasses these rules
    // entirely — no client-side read was ever needed for one). Reused below
    // exactly like hasRole('SELLER') already is: never trusts request.data
    // or any Firestore-mirrored field, only the server-verified token claim.
    function isAdmin() {
      return hasRole('ADMIN') || hasRole('SUPER_ADMIN');
    }

    // A client-issued application. `status` is forced to 'PENDING' here
    // regardless of what the client sends — the only path to 'APPROVED' is
    // functions/src/promoteSeller.ts (Admin SDK, bypasses rules entirely,
    // never a deployed/client-reachable endpoint). See docs/SECURITY.md.
    function isValidSellerApplication(data) {
      return
        data.uid is string &&
        data.status == 'PENDING' &&
        data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 80 &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 500 &&
        data.contactEmail is string && data.contactEmail.size() > 0 && data.contactEmail.size() <= 254 &&
        data.reviewedAt == null &&
        data.appliedAt == request.time &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    // Module 04 — Seller Foundation. `update`/`delete` are both `false`:
    // Firestore evaluates a write as `create` only when no document
    // currently exists at this path and as `update` otherwise, regardless
    // of whether the client called setDoc()/updateDoc() — so a second
    // application attempt (the doc already exists, PENDING or APPROVED)
    // is rejected here as an unauthorized update, giving "one application
    // per seller, never client-modifiable after submission" for free.
    match /sellers/{uid} {
      // Module 13 Phase 3 — purely additive `||`: the owner-only branch is
      // completely unchanged. An ADMIN/SUPER_ADMIN may read a PENDING
      // application only — the exact, narrow scope the seller-application
      // review queue needs, never an already-decided (APPROVED/REJECTED)
      // one, which that queue has no reason to list. Every write rule below
      // is untouched — this grants read access only, nothing else.
      // `resource != null` is required before touching `resource.data` —
      // real-emulator testing of this exact query (a genuine `list`, the
      // first one ever issued against this collection; every prior read
      // here was a single-document `get` by the doc's own owner, who always
      // exists) surfaced that Firestore's rule evaluator can throw a real
      // "Null value error" evaluating `resource.data.status` without this
      // guard — the same class of failure the artworks rule below already
      // documents and guards against for the same reason.
      allow read: if isOwner(uid) || (resource != null && resource.data.status == 'PENDING' && isAdmin());
      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        isValidSellerApplication(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    function isValidArtistDisplayName(value) {
      return value is string && value.size() >= 2 && value.size() <= 80;
    }

    function isValidArtistBio(value) {
      return value is string && value.size() >= 10 && value.size() <= 500;
    }

    // Module 06 — Artist Profiles. ArtVault's first genuinely public read
    // surface: `artists/{artistId}` is a deliberately separate collection
    // from `sellers/{uid}` (never the same document opened to public reads)
    // so a public visitor can never reach `contactEmail`, application
    // status, or any other private field — those fields simply do not
    // exist in this document at all, not just hidden by a projection.
    // `artistId` is the same value as the approved seller's own auth uid
    // (matching the `sellers/{uid}` precedent of "keyed by uid, no separate
    // generated id"), but this collection has no other relationship to
    // `sellers/{uid}` as far as rules are concerned — reading one grants no
    // access to the other.
    //
    // Only ever created by the trusted `promoteSeller.ts` (at the moment a
    // seller becomes APPROVED) or `reconcileRoles.ts` (backfilling one for
    // an already-approved seller) operator scripts, both Admin SDK and
    // never client-reachable — `allow create: if false` makes this
    // structural, not just discouraged, closing "users cannot create
    // arbitrary artist identities" and "PENDING sellers cannot obtain a
    // public profile" in one line, the same way `sellers/{uid}`'s own
    // client-side immutability is enforced.
    match /artists/{artistId} {
      // Public — no authentication required. A nonexistent artistId simply
      // returns an empty snapshot (Firestore's standard "not found" idiom
      // for an unconditional read), never a permission error, so an unknown
      // id fails safely by construction rather than needing a special case.
      allow read: if true;

      allow create: if false;

      // Only the approved seller this profile belongs to may edit it, and
      // only the two public fields declared below — `uid`/`createdAt` are
      // immutable, and `hasOnly` structurally forbids introducing any new
      // field (there is no "protected metadata" field on this document at
      // all for a client to reach in the first place).
      allow update: if
        isOwner(artistId) &&
        hasRole('SELLER') &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio', 'updatedAt']) &&
        isValidArtistDisplayName(request.resource.data.displayName) &&
        isValidArtistBio(request.resource.data.bio) &&
        request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function artworkCategories() {
      return ['painting', 'sculpture', 'photography', 'digital', 'other'];
    }

    // Module 05 — Artwork Media/Image Upload. `images` entries are metadata
    // mirrors of real Cloud Storage objects (see storage.rules) — never raw
    // bytes. `path` is pinned to exactly the owner-scoped Storage location a
    // valid upload for THIS artwork could ever land at
    // (`artworks/{sellerId}/{artworkId}/{id}`), so a client can never point
    // an artwork at another seller's or another artwork's photo, or at an
    // arbitrary external URL, by writing Firestore metadata alone — the
    // exact same "never trust Firestore alone" principle Module 04 applies
    // to authorization also applies here to media identity. `contentType`
    // and `size` mirror what storage.rules independently enforces on the
    // real object; validating them again here is defense in depth against a
    // client that writes fabricated metadata without ever uploading
    // anything through Storage at all — a gap storage.rules alone can't
    // close, since the two services are independent.
    function isValidArtworkImage(image, sellerId, artworkId) {
      return
        image.keys().hasOnly(['id', 'path', 'url', 'order', 'contentType', 'size']) &&
        image.id is string && image.id.size() > 0 && image.id.size() <= 200 &&
        image.path == 'artworks/' + sellerId + '/' + artworkId + '/' + image.id &&
        image.url is string && image.url.size() > 0 &&
        image.contentType in ['image/jpeg', 'image/png', 'image/webp'] &&
        image.size is int && image.size > 0 && image.size <= 10485760 &&
        image.order is int && image.order >= 0;
    }

    // Firestore rules have no general element-wise loop over a list, so a
    // small, fixed max image count (matching ARTWORK_MAX_IMAGES in
    // types.ts) is unrolled into individually-checked indices — safe
    // because `||` short-circuits before an out-of-bounds `images[i]` (which
    // would otherwise abort evaluation) is ever evaluated.
    function isValidImageAt(images, i, sellerId, artworkId) {
      return i >= images.size() || isValidArtworkImage(images[i], sellerId, artworkId);
    }

    function isValidArtworkImages(images, sellerId, artworkId) {
      return
        images is list &&
        images.size() <= 6 &&
        isValidImageAt(images, 0, sellerId, artworkId) &&
        isValidImageAt(images, 1, sellerId, artworkId) &&
        isValidImageAt(images, 2, sellerId, artworkId) &&
        isValidImageAt(images, 3, sellerId, artworkId) &&
        isValidImageAt(images, 4, sellerId, artworkId) &&
        isValidImageAt(images, 5, sellerId, artworkId);
    }

    // Shared by create and the "still editing while DRAFT" update branch —
    // every field-level constraint a valid artwork document must satisfy,
    // independent of its status transition.
    function isValidArtworkFields(data) {
      return
        data.sellerId is string &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 2000 &&
        data.price is int && data.price >= 100 &&
        data.category in artworkCategories() &&
        data.tags is list && data.tags.size() <= 10 &&
        data.images is list &&
        data.inventoryCount is int && data.inventoryCount >= 0;
    }

    // Module 12 — Likes. The one new non-owner write path onto
    // artworks/{artworkId}: any signed-in user (not just the owner) may
    // change *only* likeCount, by exactly +1 or -1, on a PUBLISHED artwork.
    // This is designed together with the likes/{artworkId}/by/{uid}
    // collection below as one mutually-validated mechanism — neither side
    // can succeed without the other changing correctly in the very same
    // atomic batch:
    //   - increment requires the caller's own like doc did NOT exist before
    //     this write and DOES exist after it (exists()/existsAfter());
    //   - decrement requires the reverse, plus resource.data.likeCount >= 1
    //     so the counter can never go negative.
    // A batch that changes likeCount alone (no matching like-doc write in
    // the same commit) fails here because exists()/existsAfter() then both
    // reflect the *unchanged* prior state, never satisfying either branch —
    // there is no way to move the counter without the like record actually
    // changing alongside it, and no way to change the like record without
    // the counter moving correctly (see the mirrored check on the
    // like-document rule itself, below).
    function isValidLikeCountUpdate(artworkId) {
      return
        isSignedIn() &&
        resource.data.status == 'PUBLISHED' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']) &&
        (
          (request.resource.data.likeCount == resource.data.likeCount + 1 &&
           !exists(/databases/$(database)/documents/likes/$(artworkId)/by/$(request.auth.uid)) &&
           existsAfter(/databases/$(database)/documents/likes/$(artworkId)/by/$(request.auth.uid))) ||
          (request.resource.data.likeCount == resource.data.likeCount - 1 &&
           resource.data.likeCount >= 1 &&
           exists(/databases/$(database)/documents/likes/$(artworkId)/by/$(request.auth.uid)) &&
           !existsAfter(/databases/$(database)/documents/likes/$(artworkId)/by/$(request.auth.uid)))
        );
    }

    // Module 04 — Artwork Draft Management; Module 07 — Moderation &
    // Publishing. DRAFT, SUBMITTED, PUBLISHED, REJECTED exist (see
    // docs/DATABASE.md) — no other status value is ever accepted by create
    // or update, below.
    match /artworks/{artworkId} {
      // Module 07's own addition, purely additive: a PUBLISHED artwork is
      // readable by anyone at all, signed in or not — ArtVault's first
      // public artwork read path, and the only status this applies to.
      // DRAFT/SUBMITTED/REJECTED are exactly as private as before this
      // module: still owner-only, via the second branch below, completely
      // unchanged from Module 04. No Marketplace-style "browse everyone's
      // published art" query is enabled by this rule alone — it only ever
      // grants access to documents a caller's own query or link already
      // names (e.g. one seller's own PUBLISHED artworks, per
      // subscribePublishedArtworks) — that broader browsing surface is a
      // later module's job.
      //
      // `resource == null` (a genuinely nonexistent document — the standard
      // Firestore rules idiom for this) is allowed unconditionally for any
      // signed-in user, ahead of the ownership check: a read against
      // `resource.data.sellerId` when `resource` is null would otherwise
      // fail rule evaluation entirely, denying the request the exact same
      // way as "exists but you don't own it" — indistinguishable
      // `permission-denied` errors from the client's own SDK either way.
      // That collapsed "deleted" and "someone else's" into the same vague
      // error message, which is actively wrong for a seller opening their
      // own just-deleted artwork's edit link (a real, ordinary flow — see
      // ArtworkFormPage.tsx's "Artwork not found" state and
      // useArtwork.ts). Returning an empty (non-existent) snapshot for a
      // nonexistent document leaks nothing — there's no data to leak — so
      // this is safe for any authenticated user, not just an owner;
      // reading an *existing*, non-PUBLISHED artwork still requires true
      // ownership.
      // Module 13 Phase 3 — the third, purely additive branch: an
      // ADMIN/SUPER_ADMIN may read a SUBMITTED artwork, the exact and only
      // scope the artwork-moderation review queue needs. DRAFT stays
      // exactly as owner-private as before this module (no branch here ever
      // grants an admin access to it), and PUBLISHED was already public via
      // the first branch above — this only ever adds SUBMITTED visibility.
      allow read: if
        (resource != null && resource.data.status == 'PUBLISHED') ||
        (isSignedIn() && (resource == null || isOwner(resource.data.sellerId))) ||
        (isAdmin() && resource != null && resource.data.status == 'SUBMITTED');

      allow create: if
        hasRole('SELLER') &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.status == 'DRAFT' &&
        request.resource.data.images.size() == 0 &&
        isValidArtworkFields(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      // Legal transitions from an update, as of Module 13 Phase 4: (1)
      // editing ordinary fields while still DRAFT, (2) submitting — DRAFT to
      // SUBMITTED with no other field touched, (3) a PUBLISHED artwork's
      // owner changing only the three fields that carry no content-
      // moderation risk (price/inventoryCount/tags) while remaining
      // PUBLISHED, or (4) a PUBLISHED or REJECTED artwork's owner editing
      // real public content (title/description/category/images, optionally
      // alongside price/inventoryCount/tags too) — which can never stay live
      // unreviewed, so this branch's *only* target status is SUBMITTED,
      // re-entering the exact same Admin moderation queue Module 13 Phases
      // 1-3 already built, with reviewedAt/rejectionReason forced back to
      // null (a client-chosen value here would be a real gap: it could carry
      // a stale/forged prior decision into the new review cycle).
      // A SUBMITTED artwork can still never be updated at all by its owner —
      // no branch's `resource.data.status` guard ever matches it — covers
      // "locked while awaiting review" and "SUBMITTED -> DRAFT/PUBLISHED
      // denied" together, not as separate checks. This is also, unchanged,
      // exactly what makes SUBMITTED -> PUBLISHED and SUBMITTED -> REJECTED
      // structurally impossible from a client: the only way either
      // transition ever happens is functions/src/publishArtwork.ts's
      // Admin-SDK write (via the Module 13 moderateArtwork callable),
      // which bypasses rules entirely. Every branch below independently
      // re-requires isOwner(resource.data.sellerId) via the shared outer
      // condition — a non-owner (any role) is denied by every branch alike.
      // The pre-existing owner-gated block is otherwise completely
      // unchanged — Module 12's isValidLikeCountUpdate() sibling alternative
      // via the top-level `||` is also untouched.
      allow update: if
        (
          isOwner(resource.data.sellerId) &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.updatedAt == request.time &&
          (
            (resource.data.status == 'DRAFT' &&
             request.resource.data.status == 'DRAFT' &&
             isValidArtworkFields(request.resource.data) &&
             isValidArtworkImages(request.resource.data.images, resource.data.sellerId, artworkId) &&
             // A real gap this closes (found by Module 07's own rules tests,
             // not by inspection): isValidArtworkFields() only *positively*
             // checks the fields it names — without this hasOnly(), a client
             // could sneak an extra, unlisted field (e.g. reviewedAt,
             // rejectionReason — Module 07's own new fields) into an
             // otherwise-ordinary DRAFT edit, since nothing here previously
             // rejected keys it simply never looked at. Matches the same
             // allow-list discipline the submit branch below (and
             // users/{uid}'s own update rule, Module 03) already apply.
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'description', 'price', 'category', 'tags', 'images', 'inventoryCount', 'updatedAt'])) ||
            (resource.data.status == 'DRAFT' &&
             request.resource.data.status == 'SUBMITTED' &&
             request.resource.data.images == resource.data.images &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
            // Module 13 Phase 4 — safe commerce-only fields on a PUBLISHED
            // artwork: no re-review needed, since none of these three carry
            // any public-content/moderation risk. hasOnly() alone (no
            // separate equality checks) is what proves title/description/
            // category/images stayed byte-identical — any real change to
            // them would necessarily appear in the diff and violate this
            // hasOnly(), exactly like the DRAFT branch above already relies
            // on the same mechanism.
            (resource.data.status == 'PUBLISHED' &&
             request.resource.data.status == 'PUBLISHED' &&
             request.resource.data.price is int && request.resource.data.price >= 100 &&
             request.resource.data.inventoryCount is int && request.resource.data.inventoryCount >= 0 &&
             request.resource.data.tags is list && request.resource.data.tags.size() <= 10 &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['price', 'inventoryCount', 'tags', 'updatedAt'])) ||
            // Module 13 Phase 4 — editing real public content (or any field)
            // on a PUBLISHED or REJECTED artwork always re-enters moderation
            // — the seller's own client can never keep it live/rejected with
            // unreviewed content, and can never choose reviewedAt/
            // rejectionReason itself (both forced to null here, not read
            // from the request). Reuses isValidArtworkFields/
            // isValidArtworkImages unchanged — the exact same shape
            // validation a fresh DRAFT edit already goes through.
            ((resource.data.status == 'PUBLISHED' || resource.data.status == 'REJECTED') &&
             request.resource.data.status == 'SUBMITTED' &&
             isValidArtworkFields(request.resource.data) &&
             isValidArtworkImages(request.resource.data.images, resource.data.sellerId, artworkId) &&
             request.resource.data.reviewedAt == null &&
             request.resource.data.rejectionReason == null &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'description', 'category', 'images', 'price', 'inventoryCount', 'tags',
                         'status', 'reviewedAt', 'rejectionReason', 'updatedAt']))
          )
        ) ||
        isValidLikeCountUpdate(artworkId);

      allow delete: if hasRole('SELLER') && isOwner(resource.data.sellerId) && resource.data.status == 'DRAFT';
    }

    // Module 12 — Likes. Deliberately private: the aggregate `likeCount` on
    // the artwork itself is public (same as its price/title), but *who*
    // liked a given artwork is never enumerable by anyone but that liker —
    // `allow get` is owner-only and `allow list` is unconditionally denied,
    // so no query, however narrowly filtered, can ever return a document
    // here for anyone but its own owner. This mirrors the bidder-privacy
    // posture docs/AUCTION_ARCHITECTURE.md already establishes for a
    // different collection. The document id being the liker's own uid also
    // makes a duplicate like structurally impossible: a second "like" at an
    // already-existing path is evaluated as an `update`, and `allow update`
    // is unconditionally false — a like is only ever created or removed.
    //
    // `create`/`delete` are the other half of the mutual atomic guarantee
    // described on isValidLikeCountUpdate() above: each requires the
    // artwork's own likeCount to change correctly, via getAfter()/get(), in
    // the exact same batch as this write — a like-doc write with no
    // matching counter change in the same commit is denied here, exactly as
    // a counter change with no matching like-doc write is denied there.
    match /likes/{artworkId}/by/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if
        isOwner(uid) &&
        request.resource.data.keys().hasOnly(['likedAt']) &&
        request.resource.data.likedAt == request.time &&
        get(/databases/$(database)/documents/artworks/$(artworkId)).data.status == 'PUBLISHED' &&
        getAfter(/databases/$(database)/documents/artworks/$(artworkId)).data.likeCount ==
          get(/databases/$(database)/documents/artworks/$(artworkId)).data.likeCount + 1;

      allow update: if false;

      // `resource != null` proves the like document genuinely existed
      // before this delete — without it, a batch pairing "delete a like
      // that was never created" with a real counter decrement would satisfy
      // every other check here (see isValidLikeCountUpdate's own mirrored
      // exists() check on the artwork side, which independently also
      // blocks this same case).
      allow delete: if
        isOwner(uid) &&
        resource != null &&
        getAfter(/databases/$(database)/documents/artworks/$(artworkId)).data.likeCount ==
          get(/databases/$(database)/documents/artworks/$(artworkId)).data.likeCount - 1;
    }

    // Module 09 — Wishlist. Deliberately minimal: `addedAt` is the only
    // field, and the artworkId is the document id itself, never duplicated
    // as a field to validate. Only the owning uid may ever read or write
    // their own wishlist — no other branch grants any access to it, for
    // anyone else, under any condition. A wishlist entry never makes a
    // private artwork readable: it stores no artwork data at all, so
    // resolving a saved id's real title/price/image still goes entirely
    // through the existing, unmodified `artworks/{artworkId}` rules above —
    // a wishlisted DRAFT/SUBMITTED/REJECTED artwork id simply fails to
    // resolve any data when a client tries to read it, exactly as it would
    // for anyone else. `allow update: if false` because a saved item has no
    // legitimate "edit" — it is only ever created or deleted.
    match /wishlists/{uid}/items/{artworkId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['addedAt']) &&
        request.resource.data.addedAt == request.time;
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    // Deny-by-default foundation for every other collection. Each later
    // feature module adds its own explicit, narrowly-scoped rules (with
    // role checks against custom auth claims) when that module is built.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
