rules_version = '2';

// Deny-by-default foundation. No collection is opened for read or write here.
// Each feature module adds its own explicit, narrowly-scoped rules (with role
// checks against custom auth claims) when that module is implemented.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
