rules_version = '2';

// Module 05 — Artwork Media/Image Upload. Everything not explicitly opened
// below stays denied by default (see the closing catch-all match) — the
// same deny-by-default foundation this file started with in Module 00.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Reads the SELLER custom claim directly from the auth token — never
    // trusts any Firestore mirror field, matching firestore.rules' hasRole()
    // and Module 04's invariant that the browser never grants SELLER from
    // Firestore alone.
    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isSupportedImage() {
      return request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // Cross-service Firestore lookups so an upload/delete can be scoped to
    // the artwork's actual, current lifecycle state — a client-supplied
    // Storage path alone can't prove which seller's artwork it belongs to
    // or whether that artwork is still editable, since Storage and
    // Firestore are independent services with no shared authorization
    // context otherwise.
    function artworkDoc(artworkId) {
      return firestore.get(/databases/(default)/documents/artworks/$(artworkId));
    }

    // UI-03 final correction — this used to require `status == 'DRAFT'`
    // only, which was correct when Module 05 first wrote it but went stale
    // the moment Module 13 Phase 4's "photo-editing follow-up" taught
    // useArtworkImages.ts to also stage photo edits for a PUBLISHED or
    // REJECTED artwork (see that hook's own `editable`/`staged` flags):
    // every add/remove/reorder on a PUBLISHED/REJECTED artwork was silently
    // denied by Storage, surfacing to a seller as a generic "Upload failed.
    // Try again." with no indication it was a permissions problem, not a
    // transient one. The seller artwork recovery/control pass adds
    // SUSPENDED to the same list: an admin-suspended artwork's owner may
    // now also correct its photos before resubmitting for review, exactly
    // like a REJECTED one. Only SUBMITTED stays fully locked — the one
    // status firestore.rules' own artwork update rule never lets its owner
    // touch `images` (or anything else) on either.
    function artworkExistsAndIsEditableBy(artworkId, ownerUid) {
      return firestore.exists(/databases/(default)/documents/artworks/$(artworkId)) &&
        artworkDoc(artworkId).data.sellerId == ownerUid &&
        artworkDoc(artworkId).data.status != 'SUBMITTED';
    }

    // Owner-scoped artwork photos: artworks/{ownerUid}/{artworkId}/{imageId}.
    // No public Marketplace read path exists yet (matching
    // firestore.rules' artworks/{artworkId} read rule), so reads stay
    // owner-only rather than opening media before there's any legitimate
    // way to browse it. A seller may only write/delete while (a) they are
    // signed in as the path's own owner, (b) they hold the SELLER claim,
    // and (c) the artwork this image belongs to still exists, is still
    // theirs, and is in one of the statuses its owner may still edit
    // photos on (see `artworkExistsAndIsEditableBy` above) — SUBMITTED
    // stays fully locked, matching firestore.rules exactly. `allow delete`
    // also backs the full-artwork-delete flow (useUpdateArtwork's
    // `remove()`), which best-effort deletes every image's Storage object
    // before deleting the Firestore document itself, for every status that
    // document delete is now allowed in (see firestore.rules' own
    // `allow delete`) — these two rules are deliberately kept in sync.
    match /artworks/{ownerUid}/{artworkId}/{imageId} {
      allow read: if isOwner(ownerUid);

      allow write: if isOwner(ownerUid) &&
        hasRole('SELLER') &&
        isSupportedImage() &&
        artworkExistsAndIsEditableBy(artworkId, ownerUid);

      allow delete: if isOwner(ownerUid) &&
        hasRole('SELLER') &&
        artworkExistsAndIsEditableBy(artworkId, ownerUid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
